{
	"name": "wireframe-generator",
	"version": "1.0.0",
	"description": "Generate wireframe screenshots from YAML definitions using Chakra UI",
	"type": "module",
	"scripts": {
		"generate": "bun run generate.ts",
		"dev": "bun run --bun vite",
		"build": "bun run --bun vite build",
		"preview": "bun run --bun vite preview"
	},
	"dependencies": {
		"@chakra-ui/react": "^2.8.2",
		"@emotion/react": "^11.11.3",
		"@emotion/styled": "^11.11.0",
		"framer-motion": "^11.0.3",
		"js-yaml": "^4.1.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-icons": "^5.0.1"
	},
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^20.11.0",
		"@types/react": "^18.2.48",
		"@types/react-dom": "^18.2.18",
		"@vitejs/plugin-react": "^4.2.1",
		"playwright": "^1.41.0",
		"typescript": "^5.3.3",
		"vite": "^5.0.12"
	}
}
