{
	"permissions": {
		"allow": [
			"Bash(git:*)",
			"Bash(gh:*)",
			"Bash(npm:*)",
			"Bash(npx:*)",
			"Bash(cargo:*)",
			"Bash(container-use:*)",
			"Bash(uvx:*)",
			"Read(~/.claude/*)",
			"Read(~/.config/opencode/*)",
			"mcp__sequential-thinking__*",
			"mcp__serena__*",
			"mcp__container-use__*"
		],
		"deny": [
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(./secrets/**)",
			"Read(./**/credentials.json)"
		]
	},
	"env": {
		"CLAUDE_CODE_ENABLE_TELEMETRY": "0"
	},
	"enableAllProjectMcpServers": false,
	"enabledMcpjsonServers": ["sequential-thinking", "serena", "container-use"],
	"hooks": {}
}
